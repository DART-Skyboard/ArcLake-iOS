<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <key>aps-environment</key>
    <string>production</string>

    <!-- Required on the FULL app too, not just the clip target — Apple
         verifies both declare the same associated domain to establish the
         "this App Clip belongs to this app" relationship. appclips: is a
         distinct service type from applinks: (Universal Links). -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>appclips:radicaldeepscale.com</string>
    </array>

    <!-- Normally auto-added by Xcode when creating an App Clip target
         through its own UI, which this project doesn't use — added
         manually. Declares which App Clip this app is associated with. -->
    <key>com.apple.developer.associated-appclip-app-identifiers</key>
    <array>
        <string>$(AppIdentifierPrefix)DART-Meadow-LLC.Cotharticren.Clip</string>
    </array>

    <!-- iCloud Drive document storage. These were MISSING entirely, which is
         why FileManager.url(forUbiquityContainerIdentifier:) returned nil and
         the vault silently fell back to local-only storage despite the UI
         saying work saves to iCloud Drive. Container ID must match what the
         provisioning profile permits (iCloud.dedm) or code signing fails. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.dedm</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.dedm</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
