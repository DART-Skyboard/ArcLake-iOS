<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>

    <!-- Matches Ash Tree IDE, where Sign in with Apple works reliably.
         Gives the app an explicit keychain access group so credential
         reads/writes during the SIWA flow are not subject to the default
         group being inferred differently between build configurations. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)DART-Meadow-LLC.Cotharticren</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>

    <key>aps-environment</key>
    <string>production</string>

    <!-- NOTE: com.apple.developer.associated-appclip-app-identifiers was
         REMOVED here. The ArcLakeGitHubFlow provisioning profile does not
         grant that entitlement, and signing an app with an entitlement the
         profile doesn't permit invalidates the entitlement blob at runtime —
         which is what was breaking Sign in with Apple on device/TestFlight
         even though the applesignin entitlement itself was present.
         Re-add it only after enabling App Clips on the App ID and
         regenerating the profile. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>appclips:radicaldeepscale.com</string>
    </array>

    <!-- iCloud Drive document storage. Container ID must match what the
         provisioning profile permits (iCloud.dedm) or code signing fails. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.dedm</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.dedm</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
